{
  "expo": {
    "name": "hello-world-app",
    "slug": "hello-world-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.helloworldapp"
    },
    "android": {
      "package": "com.example.helloworldapp"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
